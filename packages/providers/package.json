{
  "name": "@fishy/providers",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "import": "./dist/metadata/index.js"
    },
    "./metadata/imdb": {
      "types": "./dist/metadata/imdb/index.d.ts",
      "import": "./dist/metadata/imdb/index.js"
    },
    "./metadata/tmdb": {
      "types": "./dist/metadata/tmdb/index.d.ts",
      "import": "./dist/metadata/tmdb/index.js"
    },
    "./anime": {
      "types": "./dist/anime/index.d.ts",
      "import": "./dist/anime/index.js"
    },
    "./anime/anilist": {
      "types": "./dist/anime/anilist/index.d.ts",
      "import": "./dist/anime/anilist/index.js"
    },
    "./anime/jikan": {
      "types": "./dist/anime/jikan/index.d.ts",
      "import": "./dist/anime/jikan/index.js"
    },
    "./anime/tsuzuki": {
      "types": "./dist/anime/tsuzuki/index.d.ts",
      "import": "./dist/anime/tsuzuki/index.js"
    },
    "./anime/episodes": {
      "types": "./dist/anime/episodes/index.d.ts",
      "import": "./dist/anime/episodes/index.js"
    },
    "./ordering": {
      "types": "./dist/ordering/index.d.ts",
      "import": "./dist/ordering/index.js"
    },
    "./streaming": {
      "types": "./dist/streaming/index.d.ts",
      "import": "./dist/streaming/index.js"
    },
    "./playback": {
      "types": "./dist/playback/index.d.ts",
      "import": "./dist/playback/index.js"
    },
    "./subtitles": {
      "types": "./dist/subtitles/index.d.ts",
      "import": "./dist/subtitles/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "lint": "tsc",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
