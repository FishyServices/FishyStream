{
  "name": "@fishy/scraper",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./pages-handler": {
      "types": "./dist/proxy/pagesHandler.d.ts",
      "import": "./dist/proxy/pagesHandler.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "bun --hot src/dev.ts",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "hono": "4.12.32"
  }
}
