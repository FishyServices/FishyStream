{
  "name": "@fishy/scraper",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "bun run --hot src/dev.ts",
    "postinstall": "puppeteer browsers install chrome",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260729.1",
    "@types/bun": "latest",
    "puppeteer": "25.4.0",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.2.0",
    "hono": "4.12.32"
  }
}
