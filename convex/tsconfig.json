{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "types": ["@types/bun"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@content/*": ["../shared/content/*"],
      "@fishy/providers": ["../packages/providers/src/index.ts"],
      "@fishy/providers/metadata": ["../packages/providers/src/metadata/index.ts"],
      "@fishy/providers/metadata/tmdb": ["../packages/providers/src/metadata/tmdb/index.ts"],
      "@fishy/providers/anime/anilist": ["../packages/providers/src/anime/anilist/index.ts"],
      "@fishy/providers/playback": ["../packages/providers/src/playback/index.ts"],
      "@fishy/providers/anime": ["../packages/providers/src/anime/index.ts"],
      "@fishy/providers/anime/episodes": ["../packages/providers/src/anime/episodes/index.ts"],
      "@fishy/providers/streaming": ["../packages/providers/src/streaming/index.ts"]
    }
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
