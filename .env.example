VITE_CLERK_PUBLISHABLE_KEY=yourtoken
VITE_CONVEX_URL=https://yoururl.convex.cloud
VITE_CONVEX_SITE_URL=https://yoururl.convex.site
VITE_UMAMI_WEBSITE_ID=your_umami_website_id
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
CLERK_JWT_ISSUER_DOMAIN=https://yoururl.accounts.dev

# Cloudflare Pages secret used by /api/anime
# Configure it with: wrangler pages secret put TMDB_API_KEY
TMDB_API_KEY=your_tmdb_api_key_here

# Optional AniDub API key used by the release schedule Pages Function
# Configure it with: wrangler pages secret put ANIDUB_API_KEY --project-name fishystream
ANIDUB_API_KEY=your_anidub_api_key_here

# AnimeSchedule API token used by the release schedule Pages Function
# Configure it with: wrangler pages secret put ANIMESCHEDULE_API_TOKEN --project-name fishystream
ANIMESCHEDULE_API_TOKEN=your_animeschedule_api_token_here
